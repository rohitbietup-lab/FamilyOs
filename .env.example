# Set these in the service environment. FamilyOS does not load this file.
FAMILYOS_ENV=
FAMILYOS_SECRET_KEY=
FAMILYOS_ALLOWED_HOSTS=
FAMILYOS_CSRF_TRUSTED_ORIGINS=
FAMILYOS_DATA_DIR=
FAMILYOS_VAULT_KEY=
FAMILYOS_VAULT_ROOT=
FAMILYOS_CLAMD_HOST=
FAMILYOS_CLAMD_PORT=
FAMILYOS_GMAIL_CLIENT_ID=
FAMILYOS_GMAIL_CLIENT_SECRET=
FAMILYOS_GMAIL_REDIRECT_URI=
## Optional private Google Web application client JSON. Overrides ID/secret variables.
FAMILYOS_GMAIL_CLIENT_FILE=
# Stage 5 stays disabled unless the literal value is enabled. Configure privately.
FAMILYOS_FAMILY_ENROLLMENT=
FAMILYOS_PUBLIC_ORIGIN=
FAMILYOS_SMTP_HOST=
FAMILYOS_SMTP_PORT=587
FAMILYOS_SMTP_USER=
FAMILYOS_SMTP_PASSWORD=
FAMILYOS_FROM_EMAIL=
